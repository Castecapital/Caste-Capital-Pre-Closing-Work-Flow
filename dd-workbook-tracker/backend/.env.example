# Copy this file to .env and set real values. Never commit .env.
APP_PASSWORD=choose-a-strong-shared-password

# Postgres connection string. In production, set this to your Render
# Postgres instance's *Internal* Database URL (see DEPLOYMENT.md). If unset,
# the backend falls back to a local Postgres instance/docker-compose
# container at postgres://postgres:postgres@localhost:5432/dd_workbook_tracker
# - see README.md for local setup.
DATABASE_URL=postgres://user:password@host:5432/dbname

# TEMPORARY — only needed for the one-time POST /admin/migrate-to-postgres
# route (see adminMigrateRoute.js). Delete this variable along with that
# route once the production cutover is done. Generate a real value with
# e.g. `openssl rand -hex 32` - don't reuse APP_PASSWORD.
MIGRATION_SECRET=choose-a-separate-one-time-secret
